{
  // =====================================================================
  // MediaDNS-CDN - 图片/音频/视频外链转接 + 缓存 + 防盗链 Worker
  //
  // 部署前必做（替换下方 3 个 REPLACE）：
  //   1. 创建 KV 命名空间：  wrangler kv namespace create MAPPINGS
  //      把返回的 id 填入 kv_namespaces[0].id
  //   2. 限流 namespace_id：不是命令/控制台创建的，而是你自己定义的
  //      正整数（写成字符串，账户内唯一即可），比如 1001、1002 各填一个
  //   3. 配置机密：          wrangler secret put PASSWORD          （管理密码）
  //                         wrangler secret put SIGNING_SECRET    （HMAC 签名密钥）
  //      PASSWORD 也可在部署后于控制台 Workers -> 设置 -> 变量和机密 中添加
  //      （建议类型选"加密"即 Secret；普通 Variable 也可读取）
  //   4. 本地调试：把同样的 PASSWORD 和 SIGNING_SECRET 写入 .dev.vars
  //
  // 限流数值（limit/period）由 Cloudflare 边缘执行，改动需重新部署；
  // 其余所有设置均可在管理页（前端）运行时修改并即时生效。
  // =====================================================================
  "name": "media-dns-cdn",  // Worker 名称（Cloudflare 仅允许小写字母数字和连字符）
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",

  // 开启 Workers Caching：缓存命中时由边缘直接返回，Worker 不执行
  "cache": {
    "enabled": true
  },

  // URL 映射 + 运行时设置都存这里
  "kv_namespaces": [
    {
    "binding": "MAPPINGS", // KV 命名空间绑定名
    "id": "你的KV命名空间ID" // KV 命名空间 ID（部署前创建）
    }
  ],

  // 官方 Rate Limit Binding（每IP / 每图 / 每音视频），period 仅支持 10 或 60 秒
  "ratelimits": [
    {
      "name": "RATE_LIMITER_IP",
      "namespace_id": "1001", // 你自己定义的正整数，账户内唯一即可
      "simple": {
        "limit": 100, // 每IP访问次数限制
        "period": 60  // 限制周期（秒），仅支持 10 或 60 秒
      }
    },
    {
      "name": "RATE_LIMITER_IMG",
      "namespace_id": "1002", // 你自己定义的正整数，账户内唯一即可
      "simple": {
        "limit": 40, // 每图访问次数限制
        "period": 10 // 限制周期（秒），仅支持 10 或 60 秒
      }
    },
    {
      "name": "RATE_LIMITER_AV",
      "namespace_id": "1003", // 你自己定义的正整数，账户内唯一即可
      "simple": {
        "limit": 300, // 每音视频访问次数限制（播放会产生大量 Range 分片请求）
        "period": 10  // 限制周期（秒），仅支持 10 或 60 秒
      }
    }
  ],

  "vars": {
    // ---- 首次部署时的默认设置（之后以管理页保存到 KV 的为准）----
    // SSRF 白名单：允许代理的图床域名，逗号分隔。建议只留你信任的图床。
    "ALLOWED_ORIGINS": "",
    // 地区/IP/ASN 黑白名单（国家代码、IP、ASN 号，逗号分隔；空 = 不限制）
    "ALLOWED_COUNTRIES": "",
    "BLOCKED_COUNTRIES": "",
    "ALLOWED_IPS": "",
    "BLOCKED_IPS": "",
    "ALLOWED_ASN": "",
    "BLOCKED_ASN": "",
    // Referer 白名单：允许引用的域名，逗号分隔；空 = 不限制（尽力而为，可伪造）
    "ALLOWED_REFERERS": "",
    // HMAC 签名链接：true 则生成的链接带过期签名，不可伪造（最强防外链）
    "REQUIRE_SIGNATURE": false,
    // 签名有效期（秒）
    "SIGNATURE_TTL": 3600,
    // 缓存 TTL（秒），30 天
    "CACHE_TTL": 2592000,
    // 单张图片大小上限（字节），50MB
    "MAX_IMAGE_SIZE": 52428800,
    // 单个音频大小上限（字节），100MB
    "MAX_AUDIO_SIZE": 104857600,
    // 单个视频大小上限（字节），500MB（Cloudflare 免费版单缓存对象上限 512MB）
    "MAX_VIDEO_SIZE": 524288000,
    // 默认链接类型：redirect(仅DNS 302直跳) / proxy(缓存代理+DNS)
    "DEFAULT_MODE": "redirect",
    // OneDrive 解析自动刷新间隔（小时），最小 1，最大为缓存时长对应小时数
    "ONEDRIVE_REFRESH_HOURS": 1,
    // 转发到图床时携带的上游请求头（应对图床拦截/防盗链校验）
    "ORIGIN_REFERER": "",
    "ORIGIN_USER_AGENT": "",
    // 管理页"限流"区块展示用数值（与上面 ratelimits 保持一致）
    "RATE_LIMIT_IP_LIMIT": 100,
    "RATE_LIMIT_IP_PERIOD": 60,
    "RATE_LIMIT_IMG_LIMIT": 40,
    "RATE_LIMIT_IMG_PERIOD": 10,
    "RATE_LIMIT_AV_LIMIT": 300,
    "RATE_LIMIT_AV_PERIOD": 10
  },

  "observability": {
    "enabled": true
  },

  // 定时任务：每 5 分钟触发一次 scheduled 事件（Cloudflare 定时器不可运行时修改），
  // Worker 内部按用户设置 onedriveRefreshHours 判断是否真正刷新——
  // 距上次刷新剩余时间 ≤ 310 秒（5 分钟周期 + 10 秒缓冲）即触发刷新并更新时间，
  // 未到时间直接跳过，几乎不产生请求。
  // 遍历含 odShare 的媒体条目重新解析并回写，规避 tempauth 约 1 小时过期问题
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
